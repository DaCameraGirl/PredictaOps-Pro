# No secrets required to run this app — it serves a committed model artifact against
# a public dataset, no external API keys or credentials.

# Port the server listens on. Most PaaS platforms (Render, Railway, Fly.io) inject
# this automatically; override locally if 8000 is already in use.
PORT=8000

# Platform Core database. Local development defaults to SQLite at
# data/platform_core.db when this is unset. Production should use PostgreSQL.
PMS_DATABASE_URL=sqlite:///data/platform_core.db

# Optional separate database URL for tests and CI.
PMS_TEST_DATABASE_URL=sqlite:///:memory:

# Set to 1 to log SQL emitted by SQLAlchemy.
PMS_SQL_ECHO=0
